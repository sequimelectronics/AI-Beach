__pycache__/
*.pyc

# Machine-local engine installs, builds, runs and data. Never committed:
# third-party source (e.g. a Clawblox checkout), build output, run recordings,
# world databases, and anything from a particular household's Beach.
_local/

# Generated by `clawblox run` inside a world folder
worlds/*/renderer/dist/
worlds/*/renderer/.build.lock
worlds/*/.clawblox/
# Written by the Beach bridge (python -m beach.bridge) for the renderer
worlds/*/static/tints.json
worlds/*/static/tints.tmp
