+++ b/frontend_runtime/dist/index.html
@@ -62,7 +62,7 @@
                 class="chat-input"
                 type="text"
                 maxlength="500"
-                placeholder="Press / to chat"
+                placeholder="Press / to chat (/shout to call everyone)"
                 aria-label="Chat message"
               />
               <button id="chat-send" class="chat-send" type="submit">Send</button>
