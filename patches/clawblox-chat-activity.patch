 }
 
+/// Records activity for the idle (AFK) limit without an input (a chat message counts).
+pub fn record_activity(state: &GameManagerHandle, game_id: Uuid, agent_id: Uuid) -> Result<(), String> {
+    manager::players::record_activity(state, game_id, agent_id)
+}
