@@ -0,0 +1,45 @@
+//! HTTP/1-only serving (AI-Beach patch 13).
+//!
+//! `axum::serve` hands each connection to hyper-util's "auto" builder, which also answers an
+//! HTTP/2 prior-knowledge preface whenever hyper-util's http2 feature is compiled in (other
+//! dependencies turn it on). Nothing here needs HTTP/2: worlds are plain HTTP on the LAN and
+//! HTTP/1.1 behind a proxy. Serving HTTP/1 only removes the whole HTTP/2 server surface.
+
+use std::future::Future;
+
+use axum::Router;
+use hyper::server::conn::http1;
+use hyper_util::rt::TokioIo;
+use hyper_util::service::TowerToHyperService;
+use tokio::net::TcpListener;
+
+/// Serve `app` on `listener`, HTTP/1.1 only (websocket upgrades included), until `shutdown`
+/// completes. Stops accepting new connections then; open ones finish on their own tasks.
+pub async fn serve<F>(listener: TcpListener, app: Router, shutdown: F) -> std::io::Result<()>
+where
+    F: Future<Output = ()> + Send + 'static,
+{
+    let mut shutdown = std::pin::pin!(shutdown);
+    loop {
+        let (stream, _) = tokio::select! {
+            accepted = listener.accept() => match accepted {
+                Ok(pair) => pair,
+                // A failed accept (e.g. too many open files) shouldn't end the server.
+                Err(_) => {
+                    tokio::time::sleep(std::time::Duration::from_millis(50)).await;
+                    continue;
+                }
+            },
+            _ = &mut shutdown => return Ok(()),
+        };
+        let service = TowerToHyperService::new(app.clone());
+        tokio::spawn(async move {
+            // hyper's own HTTP/1 connection: it has no HTTP/2 code path at all. (hyper-util's auto
+            // builder ignores http1_only once upgrades are on; its docs say so, and a test caught it.)
+            let _ = http1::Builder::new()
+                .serve_connection(TokioIo::new(stream), service)
+                .with_upgrades()
+                .await;
+        });
+    }
+}
