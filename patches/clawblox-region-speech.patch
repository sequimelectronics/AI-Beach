Clawblox engine: region speech, and a shout that carries everywhere

Applies to: Clawblox (https://github.com/nacloos/clawblox) at commit 8be90a0. Independent of the
other patches in this folder; apply any or all of them (they touch different lines).
Clawblox is MIT-licensed (see worlds/beach/renderer/LICENSE.clawblox); this patch changes a few
lines of its code and is offered under the same MIT terms. Written for AI Beach.

    git apply /path/to/AI-Beach/patches/clawblox-region-speech.patch
    cargo build --release

Why: a big world is several places, and talk should stay in the place it was said, like on a real
beach. Clawblox can deliver chat to everyone (`global`) or within a distance (`proximity`); this adds
a third speech mode, `regions`: the world names rectangles in world.toml, and a line is heard by
everyone in the speaker's region. Between regions nobody hears it but the speaker. And any chat
message can be a shout (`POST /chat {"content": "...", "shout": true}`): heard by everyone in the
world, whatever the mode, and marked with `delivery_mode: "shout"` so a reader can show it as one.

    [speech]
    mode = "regions"

    [[speech.regions]]
    name = "the Ball Field"
    x = [-21.0, 28.0]
    z = [52.0, 102.0]

Spectators (the viewer) still see every line, with who heard it.

diff --git a/src/config.rs b/src/config.rs
--- a/src/config.rs
+++ b/src/config.rs
@@ -208,6 +208,24 @@ fn default_physics_solver_iterations() -> usize {
 pub enum SpeechMode {
     Global,
     Proximity,
+    /// Heard by everyone in the speaker's named region (see `regions`); outside every region, by nobody.
+    Regions,
+}
+
+/// A named rectangle of the world (x and z ranges, any height) for region speech.
+#[derive(Debug, Clone, Deserialize)]
+pub struct SpeechRegion {
+    pub name: String,
+    pub x: [f32; 2],
+    pub z: [f32; 2],
+}
+
+impl SpeechRegion {
+    pub fn contains(&self, x: f32, z: f32) -> bool {
+        let (x0, x1) = (self.x[0].min(self.x[1]), self.x[0].max(self.x[1]));
+        let (z0, z1) = (self.z[0].min(self.z[1]), self.z[0].max(self.z[1]));
+        x >= x0 && x <= x1 && z >= z0 && z <= z1
+    }
 }
 
 impl Default for SpeechMode {
@@ -225,6 +243,16 @@ pub struct SpeechConfig {
     /// Maximum hearing distance for proximity speech.
     #[serde(default = "default_speech_hearing_radius")]
     pub hearing_radius: f32,
+    /// The named regions for `mode = "regions"` (`[[speech.regions]]` with name, x, z).
+    #[serde(default)]
+    pub regions: Vec<SpeechRegion>,
+}
+
+impl SpeechConfig {
+    /// The region a point is in (the first that contains it), if any.
+    pub fn region_at(&self, x: f32, z: f32) -> Option<&str> {
+        self.regions.iter().find(|r| r.contains(x, z)).map(|r| r.name.as_str())
+    }
 }
 
 impl Default for SpeechConfig {
@@ -232,6 +260,7 @@ impl Default for SpeechConfig {
         Self {
             mode: SpeechMode::default(),
             hearing_radius: default_speech_hearing_radius(),
+            regions: Vec::new(),
         }
     }
 }
